{
  "info": {
    "_postman_id": "afriserver-collection-v210",
    "name": "AfriServer API",
    "description": "Collection Postman v2.1.0 pour AfriServer (Laravel) et AfriServeur-Files (Node). Auth Bearer héritée, variables d'environnement auto-alimentées (bearer_token, file_id).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearer_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('base_url')) {",
          "    pm.environment.set('base_url', 'http://127.0.0.1:8000');",
          "}",
          "if (!pm.environment.get('files_base_url')) {",
          "    pm.environment.set('files_base_url', 'http://127.0.0.1:3000');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is not 5xx', function () {",
          "    pm.expect(pm.response.code).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "files_base_url", "value": "http://127.0.0.1:3000" },
    { "key": "bearer_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "file_id", "value": "" },
    { "key": "x_api_key", "value": "testing-api-key" },
    { "key": "device_id", "value": "postman-device-001" },
    { "key": "profile_id", "value": "" },
    { "key": "user_email", "value": "jean@example.com" },
    { "key": "user_password", "value": "password123" },
    { "key": "country_code", "value": "CI" },
    { "key": "service_slug", "value": "whatsapp" },
    { "key": "selected_number", "value": "+2250700000001" },
    { "key": "topup_amount", "value": "1000" },
    { "key": "organisation_id", "value": "1" },
    { "key": "pays_id", "value": "1" },
    { "key": "piece_id", "value": "1" },
    { "key": "device_db_id", "value": "1" },
    { "key": "notification_id", "value": "1" },
    { "key": "plan_id", "value": "1" }
  ],
  "item": [
    {
      "name": "01 - Authentification",
      "description": "Login, OTP, refresh token et logout. Les routes publiques désactivent l'auth Bearer héritée.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.environment.set(\"bearer_token\", response.token);",
                  "}",
                  "",
                  "const data = response.data || response;",
                  "const access = data.access_token || data.token;",
                  "if (access) {",
                  "    pm.environment.set(\"bearer_token\", access);",
                  "    pm.collectionVariables.set(\"bearer_token\", access);",
                  "}",
                  "if (data.refresh_token) {",
                  "    pm.environment.set(\"refresh_token\", data.refresh_token);",
                  "    pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
                  "}",
                  "",
                  "pm.test('Login accepted or OTP challenge returned', function () {",
                  "    pm.expect([200, 201, 202]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{x_api_key}}" },
              { "key": "X-Device-Id", "value": "{{device_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"platform\": \"android\",\n  \"device_id\": \"{{device_id}}\",\n  \"device_name\": \"Postman\",\n  \"device_model\": \"CLI\",\n  \"os_version\": \"14\",\n  \"app_version\": \"1.0.0\",\n  \"fcm_token\": \"postman-fcm-token\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Démarre le flux de connexion (OTP). Si un token est renvoyé, il est stocké dans bearer_token."
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "const data = response.data || response;",
                  "const access = data.access_token || data.token || response.token;",
                  "if (access) {",
                  "    pm.environment.set(\"bearer_token\", access);",
                  "    pm.collectionVariables.set(\"bearer_token\", access);",
                  "}",
                  "if (data.refresh_token) {",
                  "    pm.environment.set(\"refresh_token\", data.refresh_token);",
                  "    pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
                  "}",
                  "if (data.user && data.user.id) {",
                  "    pm.environment.set(\"user_id\", String(data.user.id));",
                  "}",
                  "",
                  "pm.test('OTP verified and tokens issued', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    pm.expect(access).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{x_api_key}}" },
              { "key": "X-Device-Id", "value": "{{device_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"purpose\": \"login\",\n  \"code\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "verify-otp"]
            },
            "description": "Valide l'OTP et enregistre access_token / refresh_token dans l'environnement."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "const data = response.data || response;",
                  "if (data.access_token) {",
                  "    pm.environment.set(\"bearer_token\", data.access_token);",
                  "    pm.collectionVariables.set(\"bearer_token\", data.access_token);",
                  "}",
                  "if (data.refresh_token) {",
                  "    pm.environment.set(\"refresh_token\", data.refresh_token);",
                  "    pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
                  "}",
                  "",
                  "pm.test('Access token refreshed', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(data.access_token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{refresh_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "x-api-key", "value": "{{x_api_key}}" },
              { "key": "X-Device-Id", "value": "{{device_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh-token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            },
            "description": "Utilise le refresh_token (ability issue-access-token) pour renouveler le couple de jetons."
          }
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
