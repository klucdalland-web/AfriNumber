        {
          "name": "Upload Fichiers Piece",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "x-api-key", "value": "{{x_api_key}}" },
              { "key": "X-Device-Id", "value": "{{device_id}}" }
            ],
            "body": {
              "mode": "formdata",
