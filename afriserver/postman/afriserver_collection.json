    {
      "name": "03 - Afriserveur-Files",
      "description": "Service Node Afriserveur-Files. Upload KYC (multipart), détail, liste et suppression. Utilise {{files_base_url}}.",
      "item": [
        {
          "name": "Upload File",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.id) {",
                  "    pm.environment.set(\"file_id\", response.id);",
                  "}",
                  "",
                  "const data = response.data || {};",
                  "const fileId = data.id || response.id || data.idprofile || response.idprofile;",
                  "if (fileId) {",
                  "    pm.environment.set(\"file_id\", String(fileId));",
                  "    pm.collectionVariables.set(\"file_id\", String(fileId));",
                  "}",
                  "if (data.idprofile) {",
                  "    pm.environment.set(\"profile_id\", String(data.idprofile));",
                  "    pm.collectionVariables.set(\"profile_id\", String(data.idprofile));",
                  "}",
                  "",
                  "pm.test('Upload accepted', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "idprofile",
                  "value": "{{profile_id}}",
                  "type": "text",
                  "description": "UUID du profil KYC"
                },
                {
                  "key": "photopath",
                  "type": "file",
                  "src": [],
                  "description": "Photo selfie"
                },
                {
                  "key": "pieceavantpath",
                  "type": "file",
                  "src": [],
                  "description": "Recto pièce"
                },
                {
                  "key": "piecearrierepath",
                  "type": "file",
                  "src": [],
                  "description": "Verso pièce"
                }
              ]
            },
            "url": {
              "raw": "{{files_base_url}}/files/upload",
              "host": ["{{files_base_url}}"],
              "path": ["files", "upload"]
            },
            "description": "Upload multipart KYC. Enregistre file_id (ou idprofile) pour Download/Delete."
          }
        },
        {
          "name": "Download File",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{files_base_url}}/files/{{file_id}}",
              "host": ["{{files_base_url}}"],
              "path": ["files", "{{file_id}}"]
            },
            "description": "Récupère le détail / métadonnées d'un fichier via {{file_id}}."
          }
        },
        {
          "name": "List Files",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{files_base_url}}/files?idprofile={{profile_id}}",
              "host": ["{{files_base_url}}"],
              "path": ["files"],
              "query": [
                { "key": "idprofile", "value": "{{profile_id}}" }
              ]
            },
            "description": "Liste les fichiers (contrat REST prévu / à activer côté service si absent)."
          }
        },
        {
          "name": "Delete File",
          "request": {
            "auth": { "type": "noauth" },
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{files_base_url}}/files/{{file_id}}",
              "host": ["{{files_base_url}}"],
              "path": ["files", "{{file_id}}"]
            },
            "description": "Supprime un fichier via {{file_id}} (contrat REST prévu / à activer côté service si absent)."
          }
        },
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
