				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Helpers globaux collection",
					"const json = pm.response.json();",
					"",
					"pm.test('Réponse JSON valide', function () {",
					"    pm.expect(json).to.be.an('object');",
					"});",
					"",
					"if (json && json.data) {",
					"    const d = json.data;",
					"    if (d.access_token) {",
					"        pm.collectionVariables.set('access_token', d.access_token);",
					"    }",
					"    if (d.refresh_token) {",
					"        pm.collectionVariables.set('refresh_token', d.refresh_token);",
					"    }",
					"    if (d.access_token_expires_at) {",
					"        pm.collectionVariables.set('access_token_expires_at', d.access_token_expires_at);",
					"    }",
					"    if (d.refresh_token_expires_at) {",
					"        pm.collectionVariables.set('refresh_token_expires_at', d.refresh_token_expires_at);",
					"    }",
					"    if (d.user) {",
					"        const u = d.user.data || d.user;",
					"        if (u.id) pm.collectionVariables.set('user_id', String(u.id));",
					"        if (u.email) pm.collectionVariables.set('email', u.email);",
					"        if (u.phone_number) pm.collectionVariables.set('phone_number', u.phone_number);",
					"        if (u.name) pm.collectionVariables.set('user_name', u.name);",
					"        if (u.first_name) pm.collectionVariables.set('first_name', u.first_name);",
					"    }",
					"}"
				]
			}
		}
	],
