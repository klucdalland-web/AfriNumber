				{
					"name": "📝 Register",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.collectionVariables.set('otp_purpose', 'register');"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Register OK (OTP envoyé)', function () {",
									"    pm.response.to.have.status(200);",
									"    const j = pm.response.json();",
									"    pm.expect(j.success).to.eql(true);",
									"});",
									"",
									"try {",
									"    const body = JSON.parse(pm.request.body.raw);",
									"    if (body.email) pm.collectionVariables.set('email', body.email);",
									"    if (body.phone_number) pm.collectionVariables.set('phone_number', body.phone_number);",
									"    if (body.password) pm.collectionVariables.set('password', body.password);",
									"    if (body.device_id) pm.collectionVariables.set('device_id', body.device_id);",
									"    pm.collectionVariables.set('otp_purpose', 'register');",
									"    pm.collectionVariables.set('otp_code', '123456');",
									"    console.log('✅ Variables capturées → email, phone, password, otp_purpose=register');",
									"} catch (e) {",
									"    console.warn('Body non JSON, variables non mises à jour');",
									"}"
								]
							}
						}
					],
